# Edge-прокси (прод): TLS, заголовки безопасности, лимиты, JSON-ошибки.
# Монтируется как /etc/nginx/templates/default.conf.template; ${DOMAIN} подставляет
# envsubst официального образа nginx при старте. Остальные $переменные — переменные nginx.

limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;
limit_req_status 429;

# ---------- 80: только ACME и редирект на HTTPS ----------
server {
  listen 80 default_server;
  server_name _;
  server_tokens off;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
  location / {
    return 301 https://${DOMAIN}$request_uri;
  }
}

# ---------- 443: приложение ----------
server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${DOMAIN};
  server_tokens off;

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 1m;
  client_body_timeout 15s;
  client_header_timeout 15s;

  # Имена контейнеров резолвятся при запросе: edge стартует и при остановленных api/web,
  # а после перезапуска контейнера адрес обновляется (через 10 с).
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream http://api:8000;
  set $web_upstream http://web:8080;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  # Перезаписываем, а не дополняем: клиентский X-Forwarded-For не должен попасть в API
  # (иначе подмена IP обходит лимиты входа). Прокси один, CDN перед ним нет.
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-ID $request_id;
  proxy_connect_timeout 3s;
  proxy_read_timeout 30s;
  proxy_send_timeout 30s;

  # Ошибки самого nginx — в формате API (docs/api-contract-m12.md, «Ответы об ошибках»).
  error_page 413 @err_413;
  error_page 429 @err_429;
  error_page 502 503 504 @err_unavailable;

  # ----- API -----
  # Вход и обновление сессии: 30 запросов/мин на IP (точный лимит по аккаунту — backend).
  location ~ ^/api/v1/auth/(login|refresh)$ {
    limit_req zone=auth burst=10 nodelay;
    limit_req zone=api burst=40 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass $api_upstream;
  }
  # Webhook Telegram: тело ≤ 64 КБ.
  location = /api/v1/telegram/webhook {
    client_max_body_size 64k;
    limit_req zone=api burst=40 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass $api_upstream;
  }
  location /api/ {
    limit_req zone=api burst=40 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass $api_upstream;
  }
  location = /openapi.json {
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass $api_upstream;
  }

  # ----- Статика (контейнер web) -----
  # Не-API запросы при недоступном web получают статический offline.html.
  location /assets/ {
    limit_req zone=api burst=40 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    error_page 413 @err_413;
    error_page 429 @err_429;
    error_page 502 503 504 @offline;
    proxy_pass $web_upstream;
  }
  location ~ ^/(index\.html|sw\.js|manifest\.webmanifest|offline\.html)$ {
    limit_req zone=api burst=40 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-cache" always;
    error_page 413 @err_413;
    error_page 429 @err_429;
    error_page 502 503 504 @offline;
    proxy_pass $web_upstream;
  }
  location / {
    limit_req zone=api burst=40 nodelay;
    include /etc/nginx/snippets/security-headers.conf;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-cache" always;
    error_page 413 @err_413;
    error_page 429 @err_429;
    error_page 502 503 504 @offline;
    proxy_pass $web_upstream;
  }

  # ----- Служебные ответы -----
  location @offline {
    root /usr/share/nginx/offline;
    rewrite ^ /offline.html break;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }
  location @err_unavailable {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    add_header X-Request-ID $request_id always;
    return 503 '{"error":{"code":"service_unavailable","message":"Сервис временно недоступен","fields":{},"request_id":"$request_id"}}';
  }
  location @err_413 {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    add_header X-Request-ID $request_id always;
    return 413 '{"error":{"code":"payload_too_large","message":"Слишком большой запрос","fields":{},"request_id":"$request_id"}}';
  }
  location @err_429 {
    default_type application/json;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    add_header Retry-After 5 always;
    add_header X-Request-ID $request_id always;
    return 429 '{"error":{"code":"rate_limited","message":"Слишком много запросов, повторите позже","fields":{},"request_id":"$request_id"}}';
  }
}
