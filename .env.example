# Dev-окружение: cp .env.example .env. Прод — .env.prod.example.
# Полный реестр переменных: docs/api-contract-m12.md.
ENV=dev
SECRET_KEY=change-me-for-dev

# Часовой пояс «по умолчанию» (планировщик воркера, сводка директору, периоды отчётов)
APP_TIMEZONE=Europe/Moscow
# Адрес фронтенда (ссылки в уведомлениях; в dev — единственный CORS-origin вместе с CORS_ORIGINS)
PUBLIC_BASE_URL=http://localhost:5173
# Дополнительные origin через запятую (только dev; в prod игнорируется)
CORS_ORIGINS=
LOG_LEVEL=INFO

# Пароль руководителя для `make seed` (в dev без него используется значение по умолчанию)
SEED_DIRECTOR_PASSWORD=

# Telegram (docs/api-contract-m7.md): off | polling | webhook (disabled — синоним off)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Готовность и мониторинг (значения по умолчанию)
WORKER_HEARTBEAT_SECONDS=30
READY_WORKER_MAX_AGE_SECONDS=120
READY_OUTBOX_MAX_AGE_SECONDS=300
BACKUP_RETENTION_DAYS=30
APP_VERSION=dev
