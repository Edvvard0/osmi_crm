# Прод-настройки. Скопируйте в .env.prod (файл вне git, права 600: chmod 600 .env.prod) и заполните.
# Значения с пробелами берите в кавычки. Пароли и ключи генерируйте так: openssl rand -hex 32
# (только символы 0-9a-f — пароли БД попадают в URL подключения).
# Подробности и порядок запуска: docs/deployment.md. Реестр переменных: docs/api-contract-m12.md.

# ---------- Домен и сертификат ----------
# Доменное имя, DNS A-запись которого указывает на сервер (без https:// и слэшей)
DOMAIN=
# Почта для уведомлений Let's Encrypt
LETSENCRYPT_EMAIL=
# yes — согласие с условиями Let's Encrypt (требуется для make prod-cert)
LETSENCRYPT_AGREE_TOS=
# 1 — тестовый выпуск сертификата для проверки (не доверенный браузерами)
LETSENCRYPT_STAGING=
# Без домена: порт для http://<IP>:<порт> (тогда DOMAIN = IP сервера, сертификат не выпускается,
# 80/443 не занимаются; PWA и офлайн-режим без HTTPS не работают). Пусто — обычный режим с TLS.
HTTP_PORT=

# ---------- Приложение ----------
# Подпись JWT, не короче 32 символов, не равен dev-значению
SECRET_KEY=
# IANA-зона: планировщик воркера, сводка директору, периоды отчётов, время бэкапа (03:00)
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# Строка сборки для GET /system/status (например, git-хэш: APP_VERSION=$(git rev-parse --short HEAD))
APP_VERSION=
# Пароль руководителя для make prod-seed (после первого входа удалите значение из файла)
SEED_DIRECTOR_PASSWORD=

# ---------- База данных ----------
POSTGRES_USER=crm
POSTGRES_DB=crm
# Суперпользователь PostgreSQL (используется только внутри контейнера db и для restore-check)
POSTGRES_PASSWORD=
# Владелец схемы, выполняет миграции и бэкап
DB_MIGRATOR_PASSWORD=
# Роль приложения (api, worker): только DML
DB_APP_PASSWORD=

# ---------- Telegram (docs/api-contract-m7.md) ----------
# off | polling | webhook. В проде обычно webhook (после запуска: make prod-telegram-webhook)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет вебхука: случайная строка 32+ символов (A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=

# ---------- Эксплуатация ----------
WORKER_HEARTBEAT_SECONDS=30
READY_WORKER_MAX_AGE_SECONDS=120
READY_OUTBOX_MAX_AGE_SECONDS=300
BACKUP_RETENTION_DAYS=30
